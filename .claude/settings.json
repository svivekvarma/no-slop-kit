{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/slop_lint.py\" --hook || python \"${CLAUDE_PROJECT_DIR}/scripts/slop_lint.py\" --hook",
            "timeout": 15,
            "statusMessage": "Checking prose for slop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/scripts/slop_lint.py\" --hook || python \"${CLAUDE_PROJECT_DIR}/scripts/slop_lint.py\" --hook",
            "timeout": 15,
            "statusMessage": "Checking commit or PR text for slop"
          }
        ]
      }
    ]
  }
}
