{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/slop_lint.py\" --hook",
            "timeout": 15,
            "statusMessage": "Checking prose for slop"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/scripts/slop_lint.py\" --hook",
            "timeout": 15,
            "statusMessage": "Checking commit or PR text for slop"
          }
        ]
      }
    ]
  }
}
